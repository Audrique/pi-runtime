{
  "schemaVersion": 1,
  "reviewer": {
    "mode": "manual",
    "provider": null,
    "model": null,
    "reasoning": "off",
    "timeoutMs": 30000,
    "maxTokens": 2048
  },
  "permissions": {
    "authorizerChain": ["ai-authorizer"],
    "yoloMode": false,
    "permission": { "*": "ask" }
  },
  "limits": {
    "maxOpenPanes": 3,
    "maxDepth": 2,
    "maxLaunchesPerTurn": 8,
    "maxTurnsPerRun": 20,
    "maxTokensPerSession": null
  },
  "panes": { "direction": "right", "shellReadyDelayMs": 500 },
  "agents": {
    "worker": {
      "description": "Implement and verify a focused change",
      "model": null,
      "reasoning": "off",
      "tools": ["read", "write", "edit", "bash", "grep", "find", "ls"],
      "canSpawn": [],
      "prompt": "Read before editing. Implement the assigned task with small verified changes. Report changes, verification, and remaining risks.",
      "sessionMode": "standalone"
    }
  },
  "workflows": {}
}
